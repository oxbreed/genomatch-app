# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary (unsigned upload preset — defaults to duivctvcp / genomatch_profiles)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=duivctvcp
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=genomatch_profiles

# EAS production builds: set the EXPO_PUBLIC_* vars above in Expo dashboard
# Project → genomatch → Secrets, then run: npm run eas:build:ios
#
# Remote push notifications do NOT work in Expo Go (SDK 53+).
# Test push on a TestFlight or preview build from EAS.
