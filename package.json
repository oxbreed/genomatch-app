{
  "name": "genomatch-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "ribbon:extract": "RIBBON_EXPORT_SCALE=4 python3 scripts/key-ribbon-video-matted.py",
    "ribbon:extract:dark": "RIBBON_EXPORT_SCALE=4 python3 scripts/key-ribbon-video-dark.py",
    "ribbon:gif": "python3 scripts/build-ribbon-gif.py",
    "ribbon:animated": "python3 scripts/build-ribbon-animated.py",
    "ribbon:verify": "python3 scripts/verify-ribbon-assets.py",
    "test": "vitest run",
    "website:aasa": "node scripts/write-aasa.mjs",
    "supabase:link": "npx supabase link --project-ref rxmrfazktupegpfxaljo",
    "supabase:push": "npx supabase db push --linked",
    "eas:build:ios": "npx eas-cli build --platform ios --profile production",
    "eas:build:preview": "npx eas-cli build --platform android --profile preview",
    "eas:build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "eas:build:preview:android": "npx eas-cli build --platform android --profile preview",
    "eas:env:push": "npx eas-cli env:push --environment preview --path .env.local",
    "eas:submit:ios": "npx eas-cli submit --platform ios --profile production",
    "zap:baseline": "bash scripts/zap-baseline.sh"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.100.14",
    "date-fns": "^4.3.0",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-hook-form": "^7.76.1",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "supabase": "^2.103.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "private": true
}
