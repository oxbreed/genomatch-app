{
  "expo": {
    "name": "GenoMatch",
    "slug": "genomatch",
    "scheme": "genomatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "description": "GenoMatch is a genotype-aware dating app. Members share their self-reported sickle cell genotype (AA, AS, SS, AC) so compatibility is part of the conversation from the start. Educational information only, not medical advice.",
    "primaryColor": "#0B0C0E",
    "splash": {
      "image": "./assets/genomatch-ribbon-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0C0E"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.genomatch.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:genomatch.app",
        "applinks:www.genomatch.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "GenoMatch uses your camera to take a live selfie so your profile photo can be marked as photo-verified.",
        "NSPhotoLibraryUsageDescription": "GenoMatch needs access to your photos so you can upload a profile picture.",
        "NSLocationWhenInUseUsageDescription": "GenoMatch uses your location to set your city on your profile and improve nearby matching.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "ng.genomatch.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "oxbreed",
    "extra": {
      "eas": {
        "projectId": "11f7d939-f2b9-4c0c-a1bf-bd7411c45ec6"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "GenoMatch needs access to your photos so you can upload a profile picture."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GenoMatch uses your location to set your city on your profile and improve nearby matching."
        }
      ],
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C8102E",
          "defaultChannel": "messages",
          "sounds": []
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Satoshi-Regular.otf",
            "./assets/fonts/Satoshi-Medium.otf",
            "./assets/fonts/Satoshi-Bold.otf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GenoMatch uses your camera to take a live selfie for profile photo verification.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-video"
    ]
  }
}
